{
  "compilerOptions": {
    "composite": true,
    "target": "ES2025",
    "lib": ["ES2025"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@sarto/wire/*": ["./packages/sarto-wire/src/*"]
    }
  },
  "include": [
    "tools/build/third-party-notices.ts",
    "vitest.config.mts",
    "vite.daemon.config.mts",
    "src/core/**/*",
    "src/shared/**/*",
    "src/agent-host/**/*",
    "src/terminal-host/**/*",
    "src/device-host/**/*",
    "src/remote-host/**/*",
    "src/daemon/**/*"
  ],
  // The shared package's own globals are for its own check alone; Node's types replace them here.
  "exclude": ["src/shared/runtime.d.ts", "src/shared/node_modules"]
}
