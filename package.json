{
  "name": "sarto",
  "productName": "Sarto",
  "version": "0.3.4",
  "private": true,
  "description": "Sarto \u2014 The Native Agentic Development Environment.",
  "author": "Zhengru",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm typecheck && pnpm build:daemon",
    "build:daemon": "vite build -c vite.daemon.config.mts",
    "package:mac": "node apps/apple/scripts/package-mac.mjs",
    "fetch:device-helpers": "node tools/install/device-helpers.mjs",
    "fetch:cua-driver": "node tools/install/cua-driver.mjs",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:tools && pnpm typecheck:shared",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "typecheck:shared": "tsc -p src/shared/tsconfig.json",
    "lint": "eslint --cache . && node tools/check-swift-colors.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node tools/install/app-deps.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "agent-device": "0.21.36",
    "decompress": "4.2.1",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "2.7.0",
    "@decimalturn/toml-patch": "^3.3.3",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@types/node": "^24.19.2",
    "@types/semver": "7.8.0",
    "@types/ws": "8.18.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "i18next": "26.5.4",
    "jsonc-parser": "^3.3.1",
    "jszip": "3.10.2",
    "prettier": "^3.9.10",
    "semver": "7.8.6",
    "tldts": "7.4.18",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "5.0.5",
    "ws": "8.22.0",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty"
    ],
    "patchedDependencies": {
      "@expo/serve-sim@0.13.3": "patches/@expo__serve-sim@0.13.3.patch"
    }
  },
  "optionalDependencies": {
    "@expo/serve-sim": "0.13.3"
  }
}
